MOBILEACTION_API_KEY=your-mobileaction-api-key-here

# Optional: caches keyword-lookup results (get_keyword_ranking with a date,
# get_top_keywords, get_keyword_ranking_history, get_keyword_metadata,
# get_apps_for_keyword, get_organic_keywords) for 24h to avoid re-spending
# credits on a repeated query. Defaults to redis://localhost:6379/0 if unset;
# if Redis isn't reachable, the tools just fall back to a live API call.
REDIS_URL=redis://localhost:6379/0

# Optional: max number of ids get_app_names_batch will accept in one call.
# Defaults to 300, which is well under what iTunes' lookup endpoint supports.
BATCH_LOOKUP_MAX_IDS=300