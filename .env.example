MOBILEACTION_API_KEY=your-mobileaction-api-key-here

# Optional: caches get_top_keywords results for 24h to avoid re-spending
# credits on a repeated query. Defaults to redis://localhost:6379/0 if unset;
# if Redis isn't reachable, the tool just falls back to a live API call.
REDIS_URL=redis://localhost:6379/0